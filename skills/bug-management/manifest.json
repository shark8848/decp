    "bug.archive", "bug.restore",
    "task.create",
    "workspace.list", "workspace.create", "workspace.join_by_passcode"
  ],
  "depends_on_mcp_servers": ["decp"],
  "tags": ["decp", "bug", "defect", "quality"]
}
