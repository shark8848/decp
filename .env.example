# DECP 配置示例：复制为 .env 后按需修改
# 配置来源优先级：环境变量 > .env > 代码默认值（前缀 DECP_）

# ---- 存储后端：sqlite | postgres ----
DECP_STORAGE_BACKEND=sqlite
DECP_SQLITE_PATH=/home/decp/data/decp.db

# ---- PostgreSQL（DECP_STORAGE_BACKEND=postgres 时生效）----
# DECP_PG_HOST=127.0.0.1
# DECP_PG_PORT=5432
# DECP_PG_DB=decp
# DECP_PG_USER=postgres
# DECP_PG_PASSWORD=你的密码
# DECP_PG_POOL_MIN=1
# DECP_PG_POOL_MAX=10

# ---- 数字员工 Skill 工具调用模式：direct | client ----
DECP_SKILL_TOOL_BACKEND=direct
# client 模式下 MCP server 启动命令与工作目录
# DECP_SKILL_MCP_COMMAND=["python","-m","decp_core.mcp_.main"]
# DECP_SKILL_MCP_CWD=/home/decp

# ---- 报告输出目录 ----
DECP_REPORTS_DIR=/home/decp/data/reports

# ---- 日志 ----
DECP_LOG_LEVEL=INFO
# 本地滚动日志（SDK 路径：LOG_FILE_*；滚动上限 ≈ 单文件 × 备份数，防磁盘撑爆）
# 开启本地文件日志（true 时写 DECP_LOG_FILE_PATH，默认 {data_dir}/logs/decp.log）
DECP_LOG_FILE_ENABLE=true
# 单文件上限（MB），达上限即轮转，旧日志压缩为 .gz 备份
DECP_LOG_FILE_MAX_MB=50
# 滚动备份份数（共 1+backup 个文件，磁盘占用受控）
DECP_LOG_FILE_BACKUP=5


# ---- ikc-log-center 远程日志上报（log_center_sdk，pip: ikc-log-center）----
# 开关：true 时按 DECP_LOG_CENTER_URL POST {url}/ingest 上报日志到日志中心
# 依赖安装：pip install -e ".[logging]"（未安装则自动回落标准库日志）
DECP_LOG_CENTER_ENABLE=false
DECP_LOG_CENTER_URL=http://127.0.0.1:9315
# 投递方式：api | grpc | celery（逗号分隔多通道）
DECP_LOG_CENTER_DELIVERY=api
# 日志中心认证 token（服务端开启认证时必填）
DECP_LOG_CENTER_TOKEN=
# 上报超时（秒）
DECP_LOG_CENTER_TIMEOUT=2.0
